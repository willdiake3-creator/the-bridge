# --- Database ---
DATABASE_URL=postgresql+psycopg2://passage:passage@localhost:5432/passage

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS_DEFAULT=1
REFRESH_TOKEN_EXPIRE_DAYS_REMEMBER_ME=30

# Google OAuth — from console.cloud.google.com, used to verify the
# id_token the frontend gets from Google Sign-In. No client secret needed
# server-side for this flow (only the client ID, to check the token audience).
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Kpay (KPay Group-style payment gateway) ---
# NOTE: field/endpoint names below follow the general shape of KPay Group's
# public docs (payment intents with id/amount/currency/status/metaData,
# hosted checkout, webhooks, refunds — https://go.kpay-group.com). Confirm
# exact paths, auth header format, and webhook signature scheme against your
# merchant dashboard before going live — see app/payments/kpay.py for where
# to adjust.
KPAY_BASE_URL=https://api.kpay-group.com
KPAY_API_KEY=your-kpay-secret-api-key
KPAY_WEBHOOK_SECRET=your-kpay-webhook-signing-secret

# --- App ---
FRONTEND_URL=http://localhost:5500
ENVIRONMENT=development
